# Local development uses a file-backed libSQL database by default.
# Production on Vercel must use a Turso database URL and token.
TURSO_DATABASE_URL="file:./.data/vietra.db"
TURSO_AUTH_TOKEN=""

# Required in production. Generate with:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Local development falls back to a development-only secret.
AUTH_SECRET=""

# Seed accounts. Change these before the first production seed.
ADMIN_EMAIL="admin@vietra.vn"
ADMIN_PASSWORD="VieTra@2026"
DEMO_PASSWORD="VieTra@2026"

# Local API port used by the Vite proxy.
API_PORT="8787"
